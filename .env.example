# 复制为 .env。不要把真实密钥提交到 Git。
PORT=8787
DEFAULT_TIMEZONE=Asia/Shanghai

# 应用固定使用实盘交易；请先配置 API 密钥并确认交易权限。
MAX_ORDER_USDT=500
MIN_ORDER_USDT=1

BITGET_BASE_URL=https://api.bitget.com
BITGET_LOCALE=zh-CN
BITGET_API_KEY=
BITGET_SECRET_KEY=
BITGET_PASSPHRASE=
BITGET_CHANNEL_CODE=

HOST=127.0.0.1
AUTH_USER=admin
AUTH_PASSWORD=
# 可选：稳定的 AES 加密主密钥。未填写时使用登录密码哈希派生。
# ORBIT_ENCRYPTION_KEY=
# DATA_DIR=/var/lib/orbit-dca


# MySQL 5.7 数据库
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=orbit_dca
MYSQL_USER=orbit_dca
MYSQL_PASSWORD=REPLACE_WITH_MYSQL_PASSWORD
MYSQL_CONNECTION_LIMIT=10
MYSQL_BIND_ADDRESS=127.0.0.1
