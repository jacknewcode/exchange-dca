# 将 orbit.example.com 替换为你的域名后安装到 Nginx。
# 安装 HTTPS 证书前先使用本 HTTP 配置完成 DNS 验证。
upstream orbit_dca_app {
    server 127.0.0.1:8787;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name orbit.example.com;

    access_log /var/log/nginx/orbit-dca.access.log;
    error_log /var/log/nginx/orbit-dca.error.log;

    client_max_body_size 1m;
    proxy_read_timeout 75s;
    proxy_send_timeout 75s;

    location / {
        proxy_pass http://orbit_dca_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
    }
}
