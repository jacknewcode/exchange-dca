HOST=0.0.0.0
PORT=8787
AUTH_USER=admin
AUTH_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
# 可选：稳定的 AES 加密主密钥，建议使用随机长字符串。
# ORBIT_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_ENCRYPTION_KEY
DEFAULT_TIMEZONE=Asia/Shanghai
MAX_ORDER_USDT=500
MIN_ORDER_USDT=1
BITGET_BASE_URL=https://api.bitget.com
BITGET_LOCALE=zh-CN
BITGET_CHANNEL_CODE=


# MySQL 5.7 数据库
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=orbit_dca
MYSQL_USER=orbit_dca
MYSQL_PASSWORD=REPLACE_WITH_MYSQL_PASSWORD
MYSQL_CONNECTION_LIMIT=10
MYSQL_BIND_ADDRESS=127.0.0.1
