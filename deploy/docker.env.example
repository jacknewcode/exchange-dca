# Copy to the project root as .env for Docker Compose.
# Use three different strong passwords. Values below are placeholders.
AUTH_USER=admin
AUTH_PASSWORD=REPLACE_WITH_LOGIN_PASSWORD
MYSQL_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_ROOT_PASSWORD

# Use 0.0.0.0 for direct remote access; use 127.0.0.1 behind a reverse proxy.
WEB_BIND_ADDRESS=127.0.0.1
PORT=8787
DEFAULT_TIMEZONE=Asia/Shanghai
MIN_ORDER_USDT=1
MAX_ORDER_USDT=500
